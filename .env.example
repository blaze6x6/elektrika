# ============================================
# Energy Dashboard - Konfiguracija
# ============================================
# Kopiraj to datoteko v .env in prilagodi vrednosti:
#   cp .env.example .env
#   nano .env

# ── Baza podatkov ──
DB_USER=energy_user
DB_PASSWORD=energy_pass_123
DB_NAME=energydb
DB_PORT=5432

# ── Aplikacija ──
APP_PORT=3000
JWT_SECRET=spremeni_me_v_produkciji_abc123
# Število dni trajanja prijavne seje (privzeto 180)
SESSION_DAYS=180

# ── Časovni pas ──
# Pomembno za cron job in pravilne datume
TZ=Europe/Ljubljana

# ── Cron job ──
# Skrivnost za avtorizacijo cron klicev (spremeni!)
CRON_SECRET=energy_cron_secret_123

# ── Cookie varnost ──
# Nastavi na "true" SAMO če imaš HTTPS (nginx + certbot)
# Če dostopaš prek http://ip:3000, MORA biti "false"
COOKIE_SECURE=false

# ── SolarEdge API (opcijsko) ──
# Ključ dobiš na: https://monitoring.solaredge.com → Admin → Site Access → API Access
SOLAREDGE_API_KEY=
SOLAREDGE_SITE_ID=

# ── MELCloud API (opcijsko) ──
# Uporabi iste podatke kot za MELCloud mobilno aplikacijo
# Če samodejno odkrivanje naprave ne uspe, lahko ročno dodaš še MELCLOUD_DEVICE_ID
MELCLOUD_EMAIL=
MELCLOUD_PASSWORD=
MELCLOUD_DEVICE_ID=

# ── MojElektro API (opcijsko) ──
# Token dobiš na: mojelektro.si → Moj Profil → API storitve → Kreiraj žeton
# EIMM najdeš pod: Merilna mesta/merilne točke
# GSRN merilne točke potrebuješ za endpoint /merilna-tocka/{gsrn}
MOJELEKTRO_API_KEY=
MOJELEKTRO_EIMM=
MOJELEKTRO_GSRN_MT=
