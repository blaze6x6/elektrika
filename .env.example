# ============================================
# Štrom poraba – konfiguracija
# ============================================
# cp .env.example .env   in nato vpiši svoje vrednosti.
# Brez veljavnih skrivnosti (JWT_SECRET, CRON_SECRET, DB_PASSWORD) se aplikacija NE zažene.
# Skrivnosti ustvariš npr. z:   openssl rand -hex 32

# ── Baza podatkov ──
DB_USER=energy_user
# Priporočeno samo črke in številke (geslo je del DATABASE_URL): openssl rand -hex 16
DB_PASSWORD=CHANGE_ME
DB_NAME=energydb
DB_PORT=5432

# ── Aplikacija ──
APP_PORT=3000
# Podpisni ključ sej, vsaj 32 znakov (openssl rand -hex 32)
JWT_SECRET=CHANGE_ME
# Ključ za šifriranje SMTP gesla v bazi (neobvezno; sicer se izpelje iz JWT_SECRET).
# Če ga spremeniš, moraš SMTP geslo znova vnesti.
SETTINGS_KEY=
# Število dni trajanja prijavne seje (privzeto 180). Seje je mogoče razveljaviti z menjavo gesla.
SESSION_DAYS=180

# ── Začetni skrbnik (samo ob prvem zagonu, ko v bazi še ni skrbnika) ──
# Če ADMIN_PASSWORD ni nastavljen (ali je krajši od 10 znakov), se geslo ustvari
# naključno in izpiše v logu:  docker compose logs web
# Ob prvi prijavi je zamenjava gesla obvezna.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Časovni pas ──
TZ=Europe/Ljubljana

# ── Cron (dnevna sinhronizacija) ──
# Skrivnost za cron klice, vsaj 16 znakov (openssl rand -hex 24)
CRON_SECRET=CHANGE_ME
# Urnik v cron sintaksi (privzeto vsak dan ob 4:00 po TZ)
SYNC_SCHEDULE=0 4 * * *

# ── Piškotek seje / HTTPS ──
# Prazno = samodejno: "Secure", če zahteva pride prek HTTPS reverse proxyja
# (proxy mora nastaviti X-Forwarded-Proto). "true"/"false" prisili vrednost.
# Dostop prek http://ip:3000 deluje brez nastavitve.
COOKIE_SECURE=
# Dodatni dovoljeni izvori za POST zahteve, če aplikacija teče za proxyjem, ki
# ne posreduje Host glave (seznam, ločen z vejicami, npr. https://energy.moja-domena.si)
ALLOWED_ORIGINS=
# Dovoli SMTP strežnik v lokalnem omrežju na nestandardnih vratih / loopback (privzeto izklopljeno)
SMTP_ALLOW_INTERNAL=

# ── Različica slik (docker-compose.yml): "latest" ali npr. "2026.10.1" ──
APP_VERSION=latest

# ── SolarEdge API (opcijsko) ──
# Ključ: https://monitoring.solaredge.com → Admin → Site Access → API Access
SOLAREDGE_API_KEY=
SOLAREDGE_SITE_ID=
# API v2 (OAuth, »Site Access«; API v1 preneha 3. 11. 2026): https://developer.solaredge.com → Applications
# Povezavo odobriš v Administracija → SolarEdge API v2. Redirect URL v konzoli: https://<tvoja-domena>/api/solaredge/oauth/callback
SOLAREDGE_CLIENT_ID=
SOLAREDGE_CLIENT_SECRET=
# Neobvezno: če redirect URL ni samodejno pravilen (reverse proxy)
SOLAREDGE_REDIRECT_URI=
# Katero API verzijo uporabi sinhronizacija: auto (v2, če je povezan, sicer v1) | v1 | v2
SOLAREDGE_API_VERSION=auto
# Največ dni z urnimi podatki na eno sinhronizacijo (1 klic = 1 kredit; brezplačni paket: 2000 kreditov/mesec, 10 klicev/min)
SOLAREDGE_V2_HOURLY_PER_RUN=3

# ── MELCloud API (opcijsko) ──
# Uporabi iste podatke kot za MELCloud mobilno aplikacijo.
# Če samodejno odkrivanje naprave ne uspe, ročno dodaj še MELCLOUD_DEVICE_ID
MELCLOUD_EMAIL=
MELCLOUD_PASSWORD=
MELCLOUD_DEVICE_ID=

# ── MojElektro API (opcijsko) ──
# Žeton: mojelektro.si → Moj Profil → API storitve → Kreiraj žeton
# EIMM: Merilna mesta/merilne točke;  GSRN je potreben za /merilna-tocka/{gsrn}
MOJELEKTRO_API_KEY=
MOJELEKTRO_EIMM=
MOJELEKTRO_GSRN_MT=
# Pomen časovnega žiga 15-min odčitka: "end" (konec intervala, privzeto) ali "start" (začetek).
# Preveri z nadzorom "Kontrola blokov" v kalkulatorju (primerjava s SolarEdge).
MOJELEKTRO_TS_MODE=end
